# MongoDB Connection String (Atlas or local instance)
MONGODB_URI=mongodb://127.0.0.1:27017/qr_platform

# NextAuth / JWT secret for signing session cookies
NEXTAUTH_SECRET=qr-prototype-platform-secret-encryption-key-random32chars

# Application Base URL (e.g. http://localhost:3000 in dev, https://your-domain.vercel.app in prod)
NEXT_PUBLIC_APP_URL=http://localhost:3000
